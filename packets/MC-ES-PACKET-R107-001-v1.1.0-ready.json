  "scope": {
    "question": "For the exact p=8,803,369 and R=107 carrier, does the half-log deficit equal the ten-term progression {23+42j mod 53:0≤j≤9}, and does its difference set prove that the two odd-log translates saturate the quadratic-nonresidue sheet?",
    "included_work": [
      "Reconstruct the factorization of a=(p+107)/4 and the base-2 factor logarithms modulo 107.",
      "Type the even half-log subgroup isomorphism and the affine coordinate on the odd exponent coset.",
      "Enumerate the reduced support A and prove the exact progression description of its complement D.",
      "Prove D-D={42k:-9≤k≤9}, its cardinality 19, and the exclusion of the translate gap 6.",
      "Prove saturation of all 53 quadratic nonresidues by the two centered odd-factor translates.",
      "Separately enumerate the two fibres at target log 53 and the empty fibre at target log 60.",
      "Provide a readable TeX/PDF argument, a hardened standard-library Python replay, and a Lean finite certificate.",
      "Credit u/CommonCareful3149 for the community lead without reproducing private correspondence or an unpublished note."
    ],
    "excluded_work": [
      "Do not claim historical priority or global novelty.",
      "Do not infer novelty from non-occurrence in the routed local corpus.",
      "Do not claim a general residual-shell theorem, a density result, or a proof of the Erdős–Straus conjecture.",
      "Do not treat support saturation as a representation-multiplicity theorem.",
      "Do not reproduce raw transcripts, private messages, copyrighted literature files, or unlicensed archive payloads."
    ],
    "stop_conditions": [
      "Every displayed finite set and target fibre has an exact deterministic replay.",
      "The difference-set argument explicitly types both sheet coordinates and proves the translate obstruction.",
      "The standalone PDF compiles without unresolved references, box overflow, or LaTeX errors and passes visual inspection.",
      "The Lean file compiles under the pinned toolchain and reports no sorry or admit placeholders.",
      "Independent mathematical, computational, formal-acceptance, statement-correspondence, attribution, and rights/privacy reviews are requested before acceptance."
    ],
    "continuation_cursor": "ready packet published; await independent review lanes and no self-acceptance"
  },
